# Terraform working directory
**/.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive key files
*.pem
*.key

# macOS
.DS_Store

# Environment files
.env
.env.*
!.env.example

# Local AWS IAM policy files
github-actions-trust-policy.json
github-actions-ecr-policy.json

# Terraform saved plan files
*.tfplan
terraform/eks-plan
